# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Supabase-compatible stack (npm run stack:local)
/.local-stack/
.env.local.stack
!.env.example

# Supabase CLI link cache
/supabase/.temp/
/supabase/.branches/

# Demo sign-ins written by scripts/seed-demo.ts (passwords)
/demo-logins.local.md

# Copies iCloud leaves beside a file
* 2.*
