{
  "name": "ontiq-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:verify": "bash scripts/db/verify.sh",
    "db:types:local": "AFTER_CMD='supabase gen types typescript --db-url \"$DATABASE_URL?sslmode=disable\" --schema public > src/lib/supabase/database.types.ts 2>/dev/null && npx --yes oxfmt src/lib/supabase/database.types.ts >/dev/null' bash scripts/db/verify.sh",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts && npx --yes oxfmt src/lib/supabase/database.types.ts",
    "db:push": "supabase db push --include-all",
    "bootstrap:admin": "tsx --env-file-if-exists=.env.local scripts/bootstrap-super-admin.ts",
    "worker:local": "tsx --env-file-if-exists=.env.local scripts/worker-local.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "stack:local": "tsx scripts/local-stack/start.ts",
    "docs:cost": "tsx scripts/build-cost-doc.tsx",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "input-otp": "1.5.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sinhala": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@netlify/functions": "6.0.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
