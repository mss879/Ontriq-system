# Copy to .env.local for development. In production set these in
# Netlify → Site configuration → Environment variables. Never commit real values.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct database URL, only for scripts and database tests
SUPABASE_DB_URL=

# --- App --------------------------------------------------------------------
# Public address used in emailed links, e.g. https://crm.ontriq.lk
APP_ORIGIN=http://localhost:3000
# Stable key so Server Actions survive multiple server instances (openssl rand -base64 32)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Background jobs (any long random strings) -------------------------------
JOBS_WORKER_SECRET=
CRON_SECRET=
# Seals candidate link secrets and signs candidate sessions. Set once; changing it breaks links already sent
CANDIDATE_SESSION_SECRET=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Ontriq <no-reply@ontriq.lk>"
RESEND_WEBHOOK_SECRET=

# --- SMS (Notify.lk, optional) -----------------------------------------------
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=

# --- AI ------------------------------------------------------------------------
# Claude (every AI feature). Without it the AI screens say AI isn't set up and the jobs skip.
ANTHROPIC_API_KEY=
# Wall-clock budget for one assistant answer, in milliseconds (keep under the host's request limit).
ASSISTANT_BUDGET_MS=22000
# Speech-to-text for the command assistant's recorded voice notes. Leave empty to use the
# browser's own dictation only.
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
STT_COST_PER_MINUTE=0.003
